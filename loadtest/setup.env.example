# Operator admin used ONLY by seed_personas.py to create load-test accounts.
# Copy to setup.env — never commit real clinic credentials.
#
# Use your working system administrator (often admin@pococlinic.local).
# This is NOT the load-test Admin persona — seed creates that separately.

SETUP_ADMIN_EMAIL=admin@pococlinic.local
SETUP_ADMIN_KEY=
SETUP_ADMIN_PIN=

# PIN assigned to all load-test personas after seeding (4 digits)
LOADTEST_PIN=1234
