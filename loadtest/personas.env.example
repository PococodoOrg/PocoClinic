# Copy to loadtest/personas.env (gitignored). Generate with: python seed_personas.py
# Local loopback load tests only — never commit real clinic credentials.

# --- Admin (user mgmt, audit, backups list) ---
ADMIN_EMAIL=loadtest-admin@local.test
ADMIN_KEY=
ADMIN_PIN=5678
ADMIN_LOGIN=admin
ADMIN_API_ROLE=admin

# --- Manager (admin reports — uses admin role in PocoClinic RBAC) ---
MANAGER_EMAIL=loadtest-manager@local.test
MANAGER_KEY=
MANAGER_PIN=5678
MANAGER_LOGIN=admin
MANAGER_API_ROLE=admin

# --- Clinician (doctor: charting, notes, forms) ---
CLINICIAN_EMAIL=loadtest-clinician@local.test
CLINICIAN_KEY=
CLINICIAN_PIN=5678
CLINICIAN_LOGIN=staff
CLINICIAN_API_ROLE=doctor

# --- Clerk (front desk: intake — mapped to nurse role for create patient + notes) ---
CLERK_EMAIL=loadtest-clerk@local.test
CLERK_KEY=
CLERK_PIN=5678
CLERK_LOGIN=staff
CLERK_API_ROLE=nurse

# Active scenario when using locust directly (run_scenarios.py sets this per run)
# LOADTEST_SCENARIO=tiny
