[Unit]
Description=PocoClinic EMR API and web server
After=network.target

[Service]
Type=simple
User=pococlinic
Group=pococlinic
EnvironmentFile=/etc/pococlinic/env
WorkingDirectory=/opt/pococlinic
ExecStart=/opt/pococlinic/pococlinic
Restart=on-failure
RestartSec=5
# Allows Go TLS Path B to bind :443 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
