# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Security Configuration
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Environment
ENV=development

# Database — SQLite file path (required in production)
# Loaded automatically from this file when you start the backend.
# Leave empty only for throwaway in-memory UI work.
DATABASE_URL=./data/pococlinic.db

# JWT Configuration
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=24h
SESSION_INACTIVITY_TTL=15m
JWT_ISSUER=pococlinic
REFRESH_TOKEN_COOKIE=poco_refresh_token
ACCESS_TOKEN_COOKIE=poco_access_token

# Patient documents — AES-256-GCM in the database (base64 32-byte key)
# Required and non-default in production. Generate: openssl rand -base64 32
# DOCUMENT_ENCRYPTION_KEY=
# Legacy disk path (optional for older rows)
DOCUMENTS_DIR=./data/documents
BACKUP_DIR=./backups

# Local Backup Helper (cmd/ops-helper) — localhost only
OPS_HELPER_HOST=127.0.0.1
OPS_HELPER_PORT=9090
OPS_HELPER_MAIN_APP_URL=http://localhost:3000
# OPS_HELPER_HEALTH_URL=http://localhost:8080/health

# TLS (production Pi — see devices/raspberry-pi/tls-lan.md)
# SERVER_TLS_CERT=/etc/pococlinic/tls/server.crt
# SERVER_TLS_KEY=/etc/pococlinic/tls/server.key
# TRUSTED_PROXIES=127.0.0.1

# --- Frontend (frontend/.env) ---
