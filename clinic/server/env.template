# PocoClinic production environment — copy to /etc/pococlinic/env and edit secrets.
# install.sh creates this file on first install if missing.
#
# Beginner walkthrough: devices/raspberry-pi/setup.md
#
# Generate secrets on the Pi (do not leave the REPLACE placeholders — the app will refuse to start):
#   openssl rand -base64 48   → JWT_ACCESS_SECRET
#   openssl rand -base64 48   → JWT_REFRESH_SECRET  (must differ from access)
#   openssl rand -base64 32   → DOCUMENT_ENCRYPTION_KEY
#
# ALLOWED_ORIGIN must match the browser URL exactly (scheme + host + port).
# First bring-up (HTTP):  http://192.168.1.50:8080   + COOKIE_SECURE=false
# After LAN TLS:          https://pococlinic.local     (remove COOKIE_SECURE line)

ENV=production
APP_VERSION=1.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
STATIC_DIR=/opt/pococlinic/static

DATABASE_URL=/var/lib/pococlinic/pococlinic.db
RUN_MIGRATIONS=false

BACKUP_DIR=/var/lib/pococlinic/backups
DOCUMENTS_DIR=/var/lib/pococlinic/documents

# Required in production — REPLACE placeholders are intentionally invalid (app will not start)
JWT_ACCESS_SECRET=REPLACE-ME
JWT_REFRESH_SECRET=REPLACE-ME-TOO
DOCUMENT_ENCRYPTION_KEY=REPLACE-ME

# Must match the staff browser origin (see comments above)
ALLOWED_ORIGIN=http://192.168.1.50:8080

# Temporary HTTP bring-up only. Production defaults to Secure cookies (HTTPS).
# Delete this line (or set true) after enabling LAN TLS — see devices/raspberry-pi/tls-lan.md
COOKIE_SECURE=false

# TLS on the LAN (optional at first boot — required before real patient use)
# Path A (Caddy proxy): leave TLS vars unset; SERVER_HOST=127.0.0.1
# Path B (Go TLS): set cert paths and SERVER_PORT=443
# SERVER_TLS_CERT=/etc/pococlinic/tls/server.crt
# SERVER_TLS_KEY=/etc/pococlinic/tls/server.key
# TRUSTED_PROXIES=127.0.0.1

AUDIT_RETENTION_DAYS=365

OPS_HELPER_HOST=127.0.0.1
OPS_HELPER_PORT=9090
OPS_HELPER_MAIN_APP_URL=http://192.168.1.50:8080
